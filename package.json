{
  "name": "arkus",
  "version": "0.8.0",
  "private": true,
  "description": "Local-first Windows knowledge galaxy and focus companion",
  "main": "desktop/main.cjs",
  "author": "ARKUS contributors",
  "license": "UNLICENSED",
  "scripts": {
    "postinstall": "node scripts/vendor.cjs",
    "prepack": "node scripts/build-prepare.cjs",
    "predist": "node scripts/build-prepare.cjs",
    "start": "python server.py",
    "desktop": "electron .",
    "test": "python -m unittest discover -s tests -v && node --test viewer/posture.test.mjs viewer/live_voice.test.mjs viewer/live_voice_lifecycle.test.mjs viewer/camera_capture.test.mjs viewer/screen_capture.test.mjs viewer/research_tools.test.mjs viewer/gestures.test.mjs viewer/hand_gestures.test.mjs viewer/hand_ui.test.mjs viewer/cad_preview.test.mjs tests/research-utils.test.cjs tests/draft-editor.test.cjs tests/hand-model.test.cjs",
    "preflight": "python preflight.py",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable",
    "prepare:hand-model": "node scripts/prepare-hand-model.cjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.arkus.desktop",
    "productName": "ARKUS",
    "asar": false,
    "extraResources": [
      {
        "from": "work/python-runtime",
        "to": "python",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "desktop/**",
      "viewer/**",
      "server.py",
      "projects.py",
      "companion.py",
      "backup.py",
      "skill_forge.py",
      "gemini_adapter.py",
      "live_tokens.py",
      "action_executor.py",
      "cad_shapes.py",
      "parametric_cad.py",
      "knowledge_base.py",
      "mcp_gateway.py",
      "focus.py",
      "build.py",
      "preflight.py",
      "config.example.json",
      "package.json",
      "node_modules/three/**"
    ],
    "win": {
      "target": "portable"
    },
    "directories": {
      "output": "dist"
    }
  },
  "overrides": {
    "global-agent": "4.1.3"
  }
}
